# Tara Finance Agent — Environment Variables
# Copy this to .env and fill in your values

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Postgres connection string
# Local development:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/provue_tara

# Production (Neon/Supabase/Render — replace with your hosted DB URL):
# DATABASE_URL=postgres://user:password@host.neon.tech/provue_tara?sslmode=require

# Server port (default: 3000)
PORT=3000

# Log file location (default: ./logs/requests.jsonl)
LOG_FILE=./logs/requests.jsonl
